# ─── Discord Application ────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must match the redirect URI set in your Discord app's OAuth2 settings
DISCORD_REDIRECT_URI=http://localhost:3000/discord/callback

# ─── Roblox OAuth Application ────────────────────────────────────────────────
# Create an app at https://create.roblox.com/dashboard/credentials
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Must match the redirect URI set in your Roblox app's OAuth settings
ROBLOX_REDIRECT_URI=http://localhost:3000/roblox/callback

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-random-secret
# Your public base URL (use your ngrok URL for local testing)
BASE_URL=http://localhost:3000
